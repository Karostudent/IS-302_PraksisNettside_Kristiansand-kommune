@page
@model ErrorModel
@{
    Layout = null;
    ViewData["Title"] = "Feil – IS-302 Praksis";
}

<!DOCTYPE html>
<html lang="nb">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>

  <nav class="navbar">
    <div class="navbar__inner">
      <div class="navbar__logo">
        <a href="https://www.kristiansand.kommune.no" target="_blank" rel="noopener" title="Gå til Kristiansand kommune sin nettside">
          <img src="/images/L_KRS_Forenklet_byvaapen.png" alt="Kristiansand kommune, forenklet digital logo" />
        </a>
        <a href="/" title="IS-302 Praksis Hjem">
          <span>IS-302 Praksis</span>
        </a>
      </div>
      <ul class="navbar__links">
        <li><a href="/">Hjem</a></li>
        <li><a href="/prosjekt">Prosjektet</a></li>
        <li><a href="/statusrapporter">Statusrapporter</a></li>
        <li><a href="/dagbok">Dagbok</a></li>
      </ul>
    </div>
  </nav>

  <main class="container" style="padding: 4rem 1.5rem;">
    <div class="card">
      <h1 class="section__title" style="color: #c53030;">Det oppstod en feil</h1>
      <p class="section__desc">Beklager, en feil oppstod under behandling av forespørselen.</p>

      @if (Model.ShowRequestId)
      {
        <p style="margin-top: 1rem;">
          <strong>Forespørsel-ID:</strong> <code>@Model.RequestId</code>
        </p>
      }
    </div>
  </main>

  <footer class="footer">
    <p>IS-302 Praksisnettside &mdash; Kristiansand kommune &mdash; 2026</p>
  </footer>

</body>
</html>
