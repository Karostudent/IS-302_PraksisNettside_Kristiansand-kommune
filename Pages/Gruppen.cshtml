@page "/gruppen"
@model GruppenModel
@{
    Layout = null;
    ViewData["Title"] = "Gruppen – IS-302 Praksis";
}

<!DOCTYPE html>
<html lang="nb">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="navbar__inner">
      <div class="navbar__logo">
        <a href="https://www.kristiansand.kommune.no" target="_blank" rel="noopener" title="Gå til Kristiansand kommune sin nettside">
          <img src="/images/L_KRS_Forenklet_byvaapen.png" alt="Kristiansand kommune, forenklet digital logo" />
        </a>
        <a href="/" title="IS-302 Praksis Hjem">
          <span>IS-302 Praksis</span>
        </a>
      </div>
      <button class="navbar__toggle" aria-label="Meny">
        <span></span><span></span><span></span>
      </button>
      <ul class="navbar__links">
        <li><a href="/">Hjem</a></li>
        <li><a href="/prosjekt">Prosjektet</a></li>
        <li><a href="/gruppen">Gruppen</a></li>
        <li><a href="/statusrapporter">Statusrapport 1</a></li>
        <li><a href="/statusrapporter2">Statusrapport 2</a></li>
        <li><a href="/dagbok">Dagbok</a></li>
      </ul>
    </div>
  </nav>

  <header class="hero-simple">
    <div class="container">
      <p class="hero__eyebrow">IS-302 · Studentteamet</p>
      <h1 class="hero__title">Gruppen</h1>
      <p class="hero__subtitle">
        Møt studentene fra Universitetet i Agder som gjennomfører praksisoppholdet sitt i Kristiansand kommune.
      </p>
    </div>
  </header>

  <section class="section section--alt">
    <div class="container">
      <div class="section__header" style="text-align:center;">
        <span class="section__tag">Presentasjon</span>
        <h2 class="section__title">Gruppemedlemmene</h2>
        <p class="section__desc" style="margin: 0 auto;">
          Vi er to studenter på bachelor i IT- og informasjonssystemer som brenner for digitalisering, brukervennlighet og verdiskapende løsninger for kunden.
        </p>
      </div>

      <div class="grid grid--2">
        <!-- Karoline Aas-Mehren -->
        <article class="card member-card member-card--detailed">
          <div class="member-card__header">
            <div class="member-card__avatar-wrapper">
              <img src="/images/Karoline.jpeg" alt="Karoline Aas-Mehren" class="member-card__avatar member-card__avatar--zoom" />
            </div>
            <h3 class="member-card__name">Karoline Aas-Mehren</h3>
            <span class="member-card__role">Prosjektleder / Utvikler</span>
          </div>

          <div class="member-card__details">
            <div class="member-card__detail-item">
              <h4>📌 Om meg &amp; Bakgrunn</h4>
              <p>
                Jeg er bachelorstudent i IT og informasjonssystemer ved Universitetet i Agder. Inn i IT-studiene tar jeg med meg mange års 
                arbeidserfaring innen arkiv, dokumentkontroll og informasjonsforvaltning fra både offentlig og privat sektor. Jeg har også en mastergrad i engelsk språk og litteratur i bagasjen. 
                I prosjektet har jeg rollen som prosjektleder og utvikler.
              </p>
            </div>

            <div class="member-card__detail-item">
              <h4>💻 Arbeidsområder &amp; Kompetanse</h4>
              <p>
                Jeg trives spesielt godt med programmering og utvikling, og er opptatt av å lage løsninger som fungerer 
                godt teknisk og samtidig gir en god opplevelse for brukeren. Med erfaring fra arbeidslivet er jeg vant til
                 å se teknologi i sammenheng med mennesker, informasjon og arbeidsprosesser.
              </p>
              <p style="margin-top: 0.6rem;">
                Mine primære oppgaver i ALIS-tilskuddsprosjektet for Samfunnsmedisinsk enhet inkluderer:
              </p>
              <ul>
                <li>Smidig prosjektledelse, struktur og fremdriftsrapportering</li>
                <li>Kartlegging av eksisterende manuelle arbeidsprosesser (As-Is analyse)</li>
                <li>Design og prototyping av intuitivt brukergrensesnitt for saksbehandlere</li>
                <li>Utvikling av frontend-funksjonalitet og kildekode</li>
              </ul>
            </div>

            <div class="member-card__detail-item">
              <h4>🎯 Arbeidsform &amp; Motivasjon</h4>
              <p>
                I prosjektarbeid tar jeg gjerne ansvar og bidrar med struktur og framdrift. Jeg trives med samarbeid, 
                samtidig som jeg liker å sette meg inn i problemstillingene på egenhånd og finne gode, praktiske løsninger.
              </p>
            </div>
          </div>
        </article>

        <!-- Jabir Gutale -->
        <article class="card member-card member-card--detailed">
          <div class="member-card__header">
            <div class="member-card__avatar-wrapper">
              <img src="/images/Jabir.jpeg" alt="Jabir Gutale" class="member-card__avatar" />
            </div>
            <h3 class="member-card__name">Jabir Gutale</h3>
            <span class="member-card__role">Systemutvikler</span>
          </div>

          <div class="member-card__details">
            <div class="member-card__detail-item">
              <h4>📌 Om meg &amp; Bakgrunn</h4>
              <p>
                Jeg er tredjeårsstudent på bachelor i IT og informasjonssystemer ved Universitetet i Agder. Ved siden av studiene har jeg erfaring som læringsassistent ved UiA og med utviklingsarbeid hos Landmarker. I ALIS-prosjektet jobber jeg hovedsakelig med den tekniske utviklingen av løsningen.
              </p>
            </div>

            <div class="member-card__detail-item">
              <h4>💻 Arbeidsområder &amp; Kompetanse</h4>
              <p>
                Jeg er spesielt interessert i systemutvikling og liker å jobbe med backend, databaser og hvordan de ulike delene av en løsning henger sammen. I prosjektet jobber jeg med å bygge opp den tekniske delen av løsningen og implementere funksjonaliteten som skal støtte arbeidsprosessen.
              </p>
              <p>
                Mine primære oppgaver i ALIS-tilskuddsprosjektet for Samfunnsmedisinsk enhet inkluderer:
              </p>
              <ul>
                <li>Utvikling og implementering av ALIS/Veilednings-siden.</li>
                <li>Utvikling av databaseløsningen</li>
                <li>Implementering av funksjonalitet basert på behovene som avdekkes i prosjektet</li>
              </ul>
            </div>

            <div class="member-card__detail-item">
              <h4>🎯 Arbeidsform &amp; Motivasjon</h4>
              <p>
                Jeg liker å jobbe med konkrete tekniske problemstillinger og finne ut hvordan en løsning faktisk kan bygges og fungere i praksis. Jeg trives spesielt med utviklingsarbeid der jeg får gå fra et behov eller en idé til funksjonalitet som kan tas i bruk.
              </p>
            </div>
          </div>
        </article>
      </div>

    </div>
  </section>

  <footer class="footer">
    <p>IS-302 Praksisnettside &mdash; <a href="https://www.kristiansand.kommune.no" target="_blank" rel="noopener">Kristiansand kommune</a> &mdash; 2026</p>
  </footer>

  <script src="~/js/main.js" asp-append-version="true"></script>
</body>
</html>
