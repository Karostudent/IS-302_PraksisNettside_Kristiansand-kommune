@page "/"
@model IndexModel
@{
    Layout = null;
    ViewData["Title"] = "IS-302 – Praksisnettside | Kristiansand kommune";
}

<!DOCTYPE html>
<html lang="nb">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="navbar__inner">
      <div class="navbar__logo">
        <a href="https://www.kristiansand.kommune.no" target="_blank" rel="noopener" title="Gå til Kristiansand kommune sin nettside">
          <img src="/images/L_KRS_Forenklet_byvaapen.png" alt="Kristiansand kommune, forenklet digital logo" />
        </a>
        <a href="/" title="IS-302 Praksis Hjem">
          <span>IS-302 Praksis</span>
        </a>
      </div>
      <button class="navbar__toggle" aria-label="Meny">
        <span></span><span></span><span></span>
      </button>
      <ul class="navbar__links">
        <li><a href="/">Hjem</a></li>
        <li><a href="/prosjekt">Prosjektet</a></li>
        <li><a href="/statusrapporter">Statusrapporter</a></li>
        <li><a href="/dagbok">Dagbok</a></li>
      </ul>
    </div>
  </nav>

  <!-- Hero Section with Kristiansand layout -->
  <div class="hero-wrapper">
    <div class="hero-grid">
      
      <!-- Left Hero Card (Introduction & CTAs) -->
      <div class="hero-search-card">
        
        <h1 class="hero-search-card__title">Gruppe-nettside for praksis IS-302</h1>
        <p style="color: rgba(255, 255, 255, 0.9); font-size: 1.05rem; line-height: 1.6; margin-bottom: 1.5rem;">
          Vi er et studentteam fra UiA som gjennomfører et digitaliserings- og prosessforbedringsprosjekt for Kristiansand kommune. Følg vår fremdrift, statusrapporter og dagbok her.
        </p>
        
        <div style="display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
          <a href="/prosjekt" class="btn btn--accent">Les om prosjektet</a>
          <a href="/statusrapporter" class="btn btn--outline" style="color: #FFFFFF; border-color: rgba(255,255,255,0.7);">Statusrapporter</a>
        </div>

        <div class="hero-pills">
          <span class="hero-pills__label">Hurtigkoblinger</span>
          <div class="hero-pills__list">
            <a href="/prosjekt" class="pill-tag">Prosjektet</a>
            <a href="/statusrapporter" class="pill-tag">Statusrapporter</a>
            <a href="/dagbok" class="pill-tag">Dagbok</a>
            <a href="#gruppen" class="pill-tag">Studentteamet</a>
            <a href="#prosjekt-info" class="pill-tag">Målsetting</a>
          </div>
        </div>
      </div>

      <!-- Right Visual Grid (Kristiansand Color Blocks) -->
      <div class="hero-visual-grid">
        <div class="visual-block visual-block--accent-orange">
          <div class="visual-block__content">
            <span class="visual-block__title">Kristiansand kommune</span>
          </div>
        </div>
        <div class="visual-block visual-block--image" style="background:#fff; display:flex; align-items:center; justify-content:center; padding:1rem;">
          <img src="/images/L_KRS_Forenklet_byvaapen.png" alt="Kristiansand kommune byvåpen" style="max-height:90px; width:auto;" />
        </div>
        <div class="visual-block visual-block--accent-orange" style="background:var(--color-primary-dark);">
          <div class="visual-block__content">
            <span class="visual-block__title">Samfunnsmedisinsk enhet</span>
          </div>
        </div>
        <div class="visual-block visual-block--accent-yellow">
          <div class="visual-block__content">
            <span class="visual-block__title">IS-302 Praksis 2026</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Highlight Banner (Formannskapet style) -->
    <div class="highlight-banner">
      <div>
        <h2 class="highlight-banner__title">
          <a href="/prosjekt">→ Praksisoppdrag: Digitalisering i Kristiansand kommune</a>
        </h2>
        <p class="highlight-banner__desc">
          Studentteamet kartlegger og foreslår forbedringer i en arbeidsprosess i Samfunnsmedisinsk enhet. Det vi ser på
          er prosessen rundt søknad, tildeling og fordeling av tilskudd til ALIS-legene i Kristiansand kommune. Prosessen
          er i dag preget av manuell håndtering. Ukentlige møter gjennomføres med veileder i kommunen. Vi har kontorplass 
          i Rådhuskvartalet og deltar aktivt i møter og samarbeid med kommunens ansatte for å sikre en god gjennomføring av prosjektet.
        </p>
      </div>
      <div class="highlight-banner__image" style="background:var(--color-primary-light); display:flex; align-items:center; justify-content:center; padding:1.5rem;">
        <img src="/images/L_KRS_Forenklet_byvaapen.png" alt="Kristiansand kommune" style="max-height:100px; width:auto;" />
      </div>
    </div>
  </div>

  

  <!-- Project Inspo & Highlights Section -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__header" style="text-align:center;">
        <span class="section__tag">Inspirasjon &amp; Glimt</span>
        <h2 class="section__title">Prosjektet i bilde og praksis</h2>
        <p class="section__desc" style="margin: 0 auto;">
          Her viser vi frem eksempler og visuelle elementer fra vårt arbeid med Kristiansand kommune.
        </p>
      </div>

      <div class="inspo-grid inspo-grid--3">
        <!-- Inspo Card 1 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">📊</span>
            <span class="img-placeholder__label">Prosesskartlegging</span>
            <span class="img-placeholder__hint">/images/prosesskart.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Kartlegging</span>
            <h3 class="inspo-card__title">Arbeidsflyt og analysen</h3>
            <p class="inspo-card__desc">
              Visualisering av nåsituasjonen, manuelle rutiner og identifiserte flaskehalser i kommunens prosesser.
            </p>
          </div>
        </article>

        <!-- Inspo Card 2 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">🏢</span>
            <span class="img-placeholder__label">Kommunehuset &amp; Miljø</span>
            <span class="img-placeholder__hint">/images/kommunehuset.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Praksissted</span>
            <h3 class="inspo-card__title">Samfunnsmedisinsk enhet</h3>
            <p class="inspo-card__desc">
              Oppfølging og tett samarbeid med kommuneansatte og veiledere i Kristiansand kommune.
            </p>
          </div>
        </article>

        <!-- Inspo Card 3 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">🎨</span>
            <span class="img-placeholder__label">Digital Prototyping</span>
            <span class="img-placeholder__hint">/images/prototype.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Løsningsforslag</span>
            <h3 class="inspo-card__title">Skisser og wireframes</h3>
            <p class="inspo-card__desc">
              Konseptuelle skisser og trådmodeller av den nye og mer effektive digitale løsningen.
            </p>
          </div>
        </article>
      </div>

      <div style="text-align:center; margin-top:2rem;">
        <a href="/prosjekt#prosjekt-inspo" class="btn btn--primary">Se fullt inspirasjonsgalleri på Prosjekt-siden →</a>
      </div>
    </div>
  </section>

  <!-- Group Members Section -->
  <section id="gruppen" class="section section--alt">
    <div class="container">
      <div class="section__header">
        <span class="section__tag">Gruppen</span>
        <h2 class="section__title">Hvem er vi?</h2>
        <p class="section__desc">
          Vi er to studenter fra Universitetet i Agder som tar kurset IS-302
          og gjennomfører praksisopphold i Kristiansand kommune som en del av bachelor i IT og informasjonssystemer.
        </p>
      </div>

      <div class="grid grid--2">
        <div class="card member-card">
          <div class="member-card__avatar">KA</div>
          <h3 class="member-card__name">Karoline Aas-Mehren</h3>
          <p class="member-card__role">Prosjektleder / Utvikler</p>
          <p class="member-card__bio">
            Ansvarlig for utvikling, kommunikasjon med oppdragsgiver og fremdriftsrapportering. Interessert i hele utviklingsprosessen fra idé til ferdig løsning. Spesielt fokus på intuitiv brukeropplevelse.
          </p>
        </div>

        <div class="card member-card">
          <div class="member-card__avatar">JG</div>
          <h3 class="member-card__name">Jabir Gutale</h3>
          <p class="member-card__role">Utvikler / Analytiker</p>
          <p class="member-card__bio">
            Fokuserer på teknisk analyse og implementering. Interessert i
            UX og systemarkitektur.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <p>IS-302 Praksisnettside &mdash; <a href="https://www.kristiansand.kommune.no" target="_blank" rel="noopener">Kristiansand kommune</a> &mdash; 2026</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
