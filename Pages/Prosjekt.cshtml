@page "/prosjekt"
@model ProsjektModel
@{
    Layout = null;
    ViewData["Title"] = "Prosjektet – IS-302 Praksis";
}

<!DOCTYPE html>
<html lang="nb">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <nav class="navbar">
    <div class="navbar__inner">
      <div class="navbar__logo">
        <a href="https://www.kristiansand.kommune.no" target="_blank" rel="noopener" title="Gå til Kristiansand kommune sin nettside">
          <img src="/images/L_KRS_Forenklet_byvaapen.png" alt="Kristiansand kommune, forenklet digital logo" />
        </a>
        <a href="/" title="IS-302 Praksis Hjem">
          <span>IS-302 Praksis</span>
        </a>
      </div>
      <button class="navbar__toggle" aria-label="Meny">
        <span></span><span></span><span></span>
      </button>
      <ul class="navbar__links">
        <li><a href="/">Hjem</a></li>
        <li><a href="/prosjekt">Prosjektet</a></li>
        <li><a href="/statusrapporter">Statusrapporter</a></li>
        <li><a href="/dagbok">Dagbok</a></li>
      </ul>
    </div>
  </nav>

  <header class="hero-simple">
    <div class="container">
      <p class="hero__eyebrow">IS-302 · Praksisprosjekt</p>
      <h1 class="hero__title">Prosjektet</h1>
      <p class="hero__subtitle">
        Digitalisering og prosessforbedring i Kristiansand kommune, Samfunnsmedisinsk enhet.
      </p>
    </div>
  </header>

  <section class="section section--alt">
    <div class="container">

      <div class="two-col">
        <div class="info-box">
          <div class="info-box__label">Oppdragsgiver</div>
          <div class="info-box__value">Kristiansand kommune</div>
        </div>
        <div class="info-box">
          <div class="info-box__label">Avdeling</div>
          <div class="info-box__value">Samfunnsmedisinsk enhet</div>
        </div>
        <div class="info-box">
          <div class="info-box__label">Prosjektperiode</div>
          <div class="info-box__value">August – Desember 2026</div>
        </div>
        <div class="info-box">
          <div class="info-box__label">Kurs</div>
          <div class="info-box__value">IS-302, Universitetet i Agder</div>
        </div>
      </div>

      <div class="prose">
        <h2>Bakgrunn</h2>
        <p>
          Kristiansand kommune ønsker å effektivisere og modernisere en intern
          arbeidsprosess. Som del av praksisfaget IS-302 ved UiA har gruppen
          fått i oppdrag å analysere nåsituasjonen, identifisere flaskehalser
          og komme med konkrete forslag til forbedringer.
        </p>

        <h2>Mål og problemstilling</h2>
        <p>
          Prosjektets overordnede mål er å gjøre en grundig analyse av den
          valgte prosessen og presentere minst én realisérbar løsning som kan
          tas videre av kommunen etter endt praksisperiode.
        </p>
        <ul>
          <li>Kartlegge eksisterende prosess og identifisere ineffektive steg.</li>
          <li>Intervjue relevante ansatte og brukere av systemet.</li>
          <li>Lage en prototype av en forbedret løsning.</li>
          <li>Dokumentere funn i statusrapporter underveis og i en oppsummerende rapport ved semesterslutt.</li>
        </ul>

        <h2>Metode og tilnærming</h2>
        <p>
          Vi benytter en kombinasjon av kvalitative og kvantitative metoder:
        </p>
        <ul>
          <li><strong>Semistrukturerte intervjuer</strong> med kommuneansatte.</li>
          <li><strong>Observasjon</strong> av arbeidsprosessen i praksis.</li>
          <li><strong>Analyse</strong> av eksisterende rutiner og systemer.</li>
          <li><strong>Prototyping</strong> av forbedret løsning.</li>
        </ul>

        <h2>Teknologier og verktøy</h2>
        <ul>
          <li>Visual Studio Code – koding og utvikling av nettsiden</li>
          <li>Visual Studio – utvikling og testing av prototyper</li>
          <li>Microsoft Teams og e-post – kommunikasjon med oppdragsgiver</li>
          <li>GitHub – versjonskontroll og dokumentdeling</li>
        </ul>

        <h2>Planlagt tidslinje</h2>
      </div>

      <div class="timeline">
        <div class="timeline__item">
          <div class="timeline__date">August 2026</div>
          <div class="timeline__text">Oppstart, bli-kjent-møte med oppdragsgiver, prosjektplan.</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__date">September 2026</div>
          <div class="timeline__text">Datainnsamling – intervjuer, observasjon og analyse.</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__date">Oktober 2026</div>
          <div class="timeline__text">Analyse, «as-is»-modell og identifikasjon av forbedringsområder.</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__date">November 2026</div>
          <div class="timeline__text">Utvikling av prototype og «to-be»-modell. Intern testing.</div>
        </div>
        <div class="timeline__item">
          <div class="timeline__date">Desember 2026</div>
          <div class="timeline__text">Sluttrapport, presentasjon for oppdragsgiver og innlevering.</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Project Inspo & Image Showcase Section -->
  <section id="prosjekt-inspo" class="section">
    <div class="container">
      <div class="section__header">
        <span class="section__tag">Bilder &amp; Visuelt</span>
        <h2 class="section__title">Visuell oversikt over praksisarbeidet</h2>
        <p class="section__desc">
          Bildegalleri og inspirasjon som illustrerer de ulike fasene i vårt digitaliseringsprosjekt for Samfunnsmedisinsk enhet.
        </p>
      </div>

      <!-- Quick Instructions for replacing images -->
      <div class="inspo-instruction-box">
        <span class="inspo-instruction-box__icon">💡</span>
        <div>
          <h3 class="inspo-instruction-box__title">Slik legger dere inn egne bilder i prosjektet</h3>
          <p class="inspo-instruction-box__text">
            Lagre bildene deres i mappen <code>wwwroot/images/</code> (f.eks. <code>min-skisse.jpg</code>).
            Deretter kan dere i HTML-koden bytte ut <code>&lt;div class="img-placeholder"&gt;...&lt;/div&gt;</code> med <code>&lt;img src="/images/min-skisse.jpg" class="inspo-card__img" alt="Beskrivelse" /&gt;</code>.
          </p>
        </div>
      </div>

      <!-- Featured Main Concept Placeholder Card -->
      <article class="inspo-featured">
        <div class="img-placeholder">
          <span class="img-placeholder__icon" style="font-size:3rem;">🚀</span>
          <span class="img-placeholder__label" style="font-size:1.15rem;">Hovedkonsept &amp; Løsningsarkitektur</span>
          <span class="img-placeholder__hint">/images/hovedkonsept-to-be.jpg</span>
        </div>
        <div class="inspo-featured__body">
          <span class="inspo-card__tag">Fremhevet løsning</span>
          <h3 class="inspo-card__title" style="font-size:1.4rem;">Digitalisert «To-Be» Arbeidsflyt</h3>
          <p class="inspo-card__desc" style="margin-bottom:1rem;">
            Vårt hovedmål i prosjektet er å omforme den nåværende manuelle prosessen til en helhetlig, sømløs og digital arbeidsflyt. Dette bildet/illustrasjonen viser hvordan den foreslåtte løsningen vil koble sammen brukere, skjemaer og saksbehandling.
          </p>
          <div>
            <span class="badge badge--terracotta">Hovedleveranse</span>
            <span class="badge badge--green">Samfunnsmedisinsk enhet</span>
          </div>
        </div>
      </article>

      <!-- 6 Phase Inspo Grid -->
      <div class="inspo-grid inspo-grid--3">

        <!-- Phase 1 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">📄</span>
            <span class="img-placeholder__label">Manuell Nåsituasjon</span>
            <span class="img-placeholder__hint">/images/nasituasjon-skjema.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Fase 1: Nåsituasjon</span>
            <h3 class="inspo-card__title">Papirskjemaer &amp; Rutiner</h3>
            <p class="inspo-card__desc">
              Dokumentasjon av dagens arbeidshverdag med manuelle skjemaer, fysiske arkiver og tidkrevende registreringer.
            </p>
          </div>
        </article>

        <!-- Phase 2 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">🗺️</span>
            <span class="img-placeholder__label">Prosesskartlegging</span>
            <span class="img-placeholder__hint">/images/flytdiagram-asis.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Fase 2: Kartlegging</span>
            <h3 class="inspo-card__title">«As-Is» Flytdiagram</h3>
            <p class="inspo-card__desc">
              Detaljert kartlegging av alle ledd i prosessen for å lokalisere flaskehalser, dobbeltarbeid og forsinkelser.
            </p>
          </div>
        </article>

        <!-- Phase 3 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">🗣️</span>
            <span class="img-placeholder__label">Brukerinnsikt</span>
            <span class="img-placeholder__hint">/images/intervjuer-innsikt.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Fase 3: Innsikt</span>
            <h3 class="inspo-card__title">Intervjuer &amp; Behov</h3>
            <p class="inspo-card__desc">
              Innsikt samlet inn fra kvalitative intervjuer med saksbehandlere og helsepersonell i Kristiansand kommune.
            </p>
          </div>
        </article>

        <!-- Phase 4 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">🎨</span>
            <span class="img-placeholder__label">Wireframes &amp; UX</span>
            <span class="img-placeholder__hint">/images/wireframes-framer.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Fase 4: Utforming</span>
            <h3 class="inspo-card__title">Skisser &amp; Trådmodeller</h3>
            <p class="inspo-card__desc">
              Tidlige skisser og Wireframes av det nye grensesnittet for å sikre en brukervennlig og universelt utformet løsning.
            </p>
          </div>
        </article>

        <!-- Phase 5 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">⚙️</span>
            <span class="img-placeholder__label">Prototype &amp; Kode</span>
            <span class="img-placeholder__hint">/images/prototype-kode.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Fase 5: Prototyping</span>
            <h3 class="inspo-card__title">Interaktiv Prototype</h3>
            <p class="inspo-card__desc">
              Utvikling av en funksjonell prototype i kildekode som demonstrerer den nye automatisert arbeidsflyten.
            </p>
          </div>
        </article>

        <!-- Phase 6 -->
        <article class="inspo-card">
          <div class="img-placeholder">
            <span class="img-placeholder__icon">🎯</span>
            <span class="img-placeholder__label">Resultater &amp; Overlevering</span>
            <span class="img-placeholder__hint">/images/sluttpresentasjon.jpg</span>
          </div>
          <div class="inspo-card__body">
            <span class="inspo-card__tag">Fase 6: Overlevering</span>
            <h3 class="inspo-card__title">Sluttrapport &amp; Demo</h3>
            <p class="inspo-card__desc">
              Oppsummering av anbefalinger, gevinstrealisering og overlevering av prosjektresultatene til kommunen.
            </p>
          </div>
        </article>

      </div>

    </div>
  </section>

  <footer class="footer">
    <p>IS-302 Praksisnettside &mdash; Kristiansand kommune &mdash; 2026</p>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
